# ─────────────────────────────────────────────────────────────
# GreenWave 3D — environment configuration
# Copy this file to `.env` and fill in your keys.
# If ANY key is missing the app boots in "Demo Simulation Mode"
# (simulated AI + pre-seeded LocalStorage records) automatically.
# ─────────────────────────────────────────────────────────────

# Google Gemini API key — https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# Supabase project URL + anon public key — Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
